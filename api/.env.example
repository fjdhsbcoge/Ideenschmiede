# =============================================================================
# Ideenschmiede API - Beispielkonfiguration
# =============================================================================
# Diese Datei enthaelt AUSSCHLIESSLICH Platzhalter. Hier gehoeren keine echten
# Zugangsdaten hinein - auch keine echten Testdaten.
#
# Verwendung: nach api/.env kopieren (steht in api/.gitignore) oder die
# Variablen direkt in der Umgebung setzen. Bereits gesetzte
# Umgebungsvariablen haben Vorrang vor api/.env.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE_URL - PFLICHTWERT, KEIN STANDARDWERT
# -----------------------------------------------------------------------------
# Ohne diesen Wert startet die API nicht. Sie meldet das im Klartext und endet
# mit Exit-Code 1, statt still auf eine geratene Datenbank auszuweichen - eine
# geratene Verbindung faellt sonst erst beim ersten Schreibvorgang auf, und
# dann in einer Datenbank, die niemand gemeint hat.
#
# Format: postgres://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
# Sonderzeichen im Passwort muessen URL-kodiert sein (@ -> %40).
DATABASE_URL=postgres://BENUTZER:PASSWORT@localhost:5432/ideenschmiede

# -----------------------------------------------------------------------------
# SESSION_SECRET - PFLICHTWERT, KEIN STANDARDWERT
# -----------------------------------------------------------------------------
# Geheimnis, mit dem die Sitzungs-Token signiert werden (HS256). Ohne diesen
# Wert startet die API nicht.
#
# Warum kein Standardwert: ein fest eingebautes Geheimnis steht in der
# Versionsverwaltung - wer es kennt, kann sich fuer JEDEN Nutzer ein gueltiges
# Token ausstellen. Es gehoert deshalb auch niemals in eine Datei, die
# eingecheckt wird (diese Datei hier enthaelt nur einen Platzhalter).
#
# Erzeugen (48 zufaellige Byte, base64url):
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Mindestens 32 Zeichen. Ein zu kurzer Wert wird abgewiesen - nicht aus
# kryptografischer Notwendigkeit, sondern weil "geheim" und "test" sonst
# durchgehen.
SESSION_SECRET=BITTE_EIN_EIGENES_GEHEIMNIS_EINSETZEN_MINDESTENS_32_ZEICHEN

# -----------------------------------------------------------------------------
# AUTH_BASE_URL - PFLICHTWERT, KEIN STANDARDWERT
# -----------------------------------------------------------------------------
# Basis-URL DIESER Instanz. Aus ihr wird die Callback-Adresse gebaut, die im
# QR-Code steckt: <AUTH_BASE_URL>/api/auth/callback?tag=login&k1=...&action=...
#
# ACHTUNG, das ist der heikelste Wert der ganzen Konfiguration: Wallets leiten
# den linkingKey aus dem VOLLEN Domainnamen ab. Wird diese Adresse spaeter
# geaendert (auch nur auth.example.com -> login.example.com), leitet dieselbe
# Wallet einen ANDEREN Schluessel ab - bestehende Konten sind dann nicht mehr
# erreichbar, und die Nutzer bekommen still ein neues. Die Domain muss also vor
# dem ersten Login feststehen.
#
# Erlaubt sind nur absolute http(s)-URLs ohne Query, ohne Fragment und ohne
# Zugangsdaten. Kein Schraegstrich am Ende noetig - er wird entfernt.
# Im Entwicklungsbetrieb zeigt sie auf denselben Host wie PORT/HOST; der
# Domainname ist dann lokal, und die Konten gelten nur dort.
AUTH_BASE_URL=https://auth.ideenschmiede.example

# -----------------------------------------------------------------------------
# BTCPAY_WEBHOOK_SECRET - PFLICHTWERT FUER DEN BETRIEB, KEIN STANDARDWERT
# -----------------------------------------------------------------------------
# Geheimnis, mit dem BTCPay jede Webhook-Zustellung signiert. Ohne diesen Wert
# startet die API nicht (src/server.ts).
#
# Warum kein Standardwert: wer das Geheimnis kennt, kann eine Zustellung mit
# gueltiger Signatur erzeugen - und der Webhook verleiht daraufhin die Rolle
# 'subscriber' (ADR-003: das Abonnement ist das Stimmrecht). Ein fest
# eingebautes Geheimnis waere also eine Hintertuer zum Stimmrecht.
#
# Das Verfahren: BTCPay schickt den Kopf 'BTCPay-Sig' mit
# hex(hmac_sha256(geheimnis, ROHER_KOERPER)). Geprueft wird ueber die rohen Bytes
# der Anfrage - nicht ueber eine neu serialisierte Fassung (siehe api/README.md,
# "BTCPay-Webhook").
#
# Der Wert kommt aus BTCPay Server: Store -> Webhooks -> <Webhook> -> Secret.
BTCPAY_WEBHOOK_SECRET=BITTE_DAS_WEBHOOK_GEHEIMNIS_AUS_BTCPAY_EINSETZEN

# -----------------------------------------------------------------------------
# POSTGRES_* - NUR fuer den Betrieb mit Docker Compose (api/docker-compose.yml)
# -----------------------------------------------------------------------------
# Diese Werte braucht der Datenbank-Behler. Fuer den Betrieb OHNE Container
# werden sie nicht gelesen - dort steht die Verbindung vollstaendig in
# DATABASE_URL (siehe oben).
#
# Pflichtwerte ohne Standardwert: fehlt einer, bricht schon die Auswertung der
# Datei ab ('required variable POSTGRES_USER is missing a value'). Das ist
# Absicht - ein Stapel mit halber Konfiguration sieht aus als liefe er.
POSTGRES_USER=ideenschmiede
POSTGRES_PASSWORD=BITTE_EIN_EIGENES_PASSWORT_EINSETZEN
POSTGRES_DB=ideenschmiede

# Groessen des Datenbankservers. Die Vorgaben sind fuer einen kleinen Rechner
# zu grosszuegig; auf einer Synology DS 224+ haben sich diese Werte bewaehrt:
#   POSTGRES_SHARED_BUFFERS=64MB
#   POSTGRES_WORK_MEM=8MB
#   POSTGRES_MAX_CONNECTIONS=20
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=40

# -----------------------------------------------------------------------------
# API_BIND / API_PORT - nur fuer Docker Compose
# -----------------------------------------------------------------------------
# Adresse und Port, unter denen die API auf dem WIRT erreichbar ist.
#
# Die Voreinstellung bindet an die Schleife (127.0.0.1). Nach aussen kommt die
# API ausschliesslich ueber den Reverse Proxy, der auch TLS beendet - erst
# recht bei einer Anmeldung per Wallet.
API_BIND=127.0.0.1
API_PORT=3000

# -----------------------------------------------------------------------------
# PORT - optional
# -----------------------------------------------------------------------------
# Port der HTTP-Schnittstelle. Standard: 3000. Erlaubt: 1..65535.
# Ein unbrauchbarer Wert (Text, 0, 70000) fuehrt zum Abbruch beim Start.
PORT=3000

# -----------------------------------------------------------------------------
# HOST - optional
# -----------------------------------------------------------------------------
# Adresse, auf der gelauscht wird. Standard: 127.0.0.1 - also nur lokal
# erreichbar. In einem Container (Docker Compose, Roadmap Phase 3.1) auf
# 0.0.0.0 setzen, sonst ist die API von aussen nicht ansprechbar.
HOST=127.0.0.1

# -----------------------------------------------------------------------------
# NODE_ENV - optional
# -----------------------------------------------------------------------------
# Erlaubt: development, test, production. Standard: development.
NODE_ENV=development

# -----------------------------------------------------------------------------
# AUTH_RATE_LIMIT - optional, Standard 30
# -----------------------------------------------------------------------------
# Erlaubte Aufrufe von POST /api/auth/challenge je Client-Adresse und Fenster.
#
# Der Endpunkt ist OEFFENTLICH (keine Sitzung noetig) und legt bei jedem Aufruf
# eine Zeile in auth_challenges an. Die Begrenzung steht in der DATENBANK
# (auth_rate_events, Migration 005) und nicht im Arbeitsspeicher: ein Zaehler im
# Speicher geht beim Neustart verloren und gilt bei mehreren Instanzen nur je
# Prozess (ADR-004).
#
# Warum 30 je Minute: eine Anmeldung ist EIN Aufruf. 30 sind deutlich mehr, als
# ein echter Anmeldeversuch braucht (QR-Code erzeugen, scannen, bestaetigen,
# ein oder zwei Fehlversuche), und deutlich weniger als eine Schleife. Wer
# weniger will, senkt den Wert; wer viele Nutzer hinter EINER Adresse hat (NAT,
# Firmennetz), hebt ihn an - siehe AUTH_TRUSTED_PROXIES.
#
# Erlaubt: 1..10000. Ein unbrauchbarer Wert bricht den Start ab (kein stiller
# Rueckfall auf den Standardwert).
AUTH_RATE_LIMIT=30

# -----------------------------------------------------------------------------
# AUTH_RATE_WINDOW_MS - optional, Standard 60000
# -----------------------------------------------------------------------------
# Laenge des GLEITENDEN Fensters in Millisekunden. Gezaehlt wird ueber die
# letzten AUTH_RATE_WINDOW_MS, nicht ueber ein Kalenderfenster: ein Zaehler je
# Kalenderfenster erlaubt am Fensterrand die doppelte Menge (29 kurz davor, 30
# direkt danach) und waere damit genau dort umgehbar, wo jemand es versucht.
#
# Erlaubt: 1000 (1 Sekunde) .. 86400000 (1 Tag).
AUTH_RATE_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# AUTH_TRUSTED_PROXIES - optional, Standard: leer (kein Proxy)
# -----------------------------------------------------------------------------
# Adressen von Reverse Proxies, deren Kopf X-Forwarded-For GEGLAUBT wird -
# kommasepariert, z.B. 127.0.0.1,172.17.0.1
#
# WARUM DIE VORGABE LEER IST: X-Forwarded-For ist ein gewoehnlicher HTTP-Kopf
# und von jedem Aufrufer setzbar. Wuerde er immer gelesen, schriebe ein
# Angreifer in jede Anfrage eine andere erfundene Adresse - die Begrenzung liefe
# fuer ihn nie an. Geglaubt wird der Kopf deshalb nur, wenn die Verbindung
# SELBST von einer hier eingetragenen Adresse kommt.
#
# KONSEQUENZ, die man kennen muss: laeuft die API hinter einem Reverse Proxy
# und steht dieser Proxy NICHT hier, dann ist die Client-Adresse fuer alle
# Aufrufer die des Proxys - sie teilen sich EINEN Topf, und ein einzelner
# Vielnutzer bremst alle anderen aus.
#
# Erlaubt sind einzelne IPv4- und IPv6-Adressen. KEINE CIDR-Bereiche und keine
# Hostnamen. Bei mehreren Proxies hintereinander muss jeder eingetragen sein.
AUTH_TRUSTED_PROXIES=