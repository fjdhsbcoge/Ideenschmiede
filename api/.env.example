# =============================================================================
# Ideenschmiede API - Beispielkonfiguration
# =============================================================================
# Diese Datei enthaelt AUSSCHLIESSLICH Platzhalter. Hier gehoeren keine echten
# Zugangsdaten hinein - auch keine echten Testdaten.
#
# Verwendung: nach api/.env kopieren (steht in api/.gitignore) oder die
# Variablen direkt in der Umgebung setzen. Bereits gesetzte
# Umgebungsvariablen haben Vorrang vor api/.env.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE_URL - PFLICHTWERT, KEIN STANDARDWERT
# -----------------------------------------------------------------------------
# Ohne diesen Wert startet die API nicht. Sie meldet das im Klartext und endet
# mit Exit-Code 1, statt still auf eine geratene Datenbank auszuweichen - eine
# geratene Verbindung faellt sonst erst beim ersten Schreibvorgang auf, und
# dann in einer Datenbank, die niemand gemeint hat.
#
# Format: postgres://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
# Sonderzeichen im Passwort muessen URL-kodiert sein (@ -> %40).
DATABASE_URL=postgres://BENUTZER:PASSWORT@localhost:5432/ideenschmiede

# -----------------------------------------------------------------------------
# SESSION_SECRET - PFLICHTWERT, KEIN STANDARDWERT
# -----------------------------------------------------------------------------
# Geheimnis, mit dem die Sitzungs-Token signiert werden (HS256). Ohne diesen
# Wert startet die API nicht.
#
# Warum kein Standardwert: ein fest eingebautes Geheimnis steht in der
# Versionsverwaltung - wer es kennt, kann sich fuer JEDEN Nutzer ein gueltiges
# Token ausstellen. Es gehoert deshalb auch niemals in eine Datei, die
# eingecheckt wird (diese Datei hier enthaelt nur einen Platzhalter).
#
# Erzeugen (48 zufaellige Byte, base64url):
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Mindestens 32 Zeichen. Ein zu kurzer Wert wird abgewiesen - nicht aus
# kryptografischer Notwendigkeit, sondern weil "geheim" und "test" sonst
# durchgehen.
SESSION_SECRET=BITTE_EIN_EIGENES_GEHEIMNIS_EINSETZEN_MINDESTENS_32_ZEICHEN

# -----------------------------------------------------------------------------
# AUTH_BASE_URL - PFLICHTWERT, KEIN STANDARDWERT
# -----------------------------------------------------------------------------
# Basis-URL DIESER Instanz. Aus ihr wird die Callback-Adresse gebaut, die im
# QR-Code steckt: <AUTH_BASE_URL>/api/auth/callback?tag=login&k1=...&action=...
#
# ACHTUNG, das ist der heikelste Wert der ganzen Konfiguration: Wallets leiten
# den linkingKey aus dem VOLLEN Domainnamen ab. Wird diese Adresse spaeter
# geaendert (auch nur auth.example.com -> login.example.com), leitet dieselbe
# Wallet einen ANDEREN Schluessel ab - bestehende Konten sind dann nicht mehr
# erreichbar, und die Nutzer bekommen still ein neues. Die Domain muss also vor
# dem ersten Login feststehen.
#
# Erlaubt sind nur absolute http(s)-URLs ohne Query, ohne Fragment und ohne
# Zugangsdaten. Kein Schraegstrich am Ende noetig - er wird entfernt.
# Im Entwicklungsbetrieb zeigt sie auf denselben Host wie PORT/HOST; der
# Domainname ist dann lokal, und die Konten gelten nur dort.
AUTH_BASE_URL=https://auth.ideenschmiede.example

# -----------------------------------------------------------------------------
# BTCPAY_WEBHOOK_SECRET - PFLICHTWERT FUER DEN BETRIEB, KEIN STANDARDWERT
# -----------------------------------------------------------------------------
# Geheimnis, mit dem BTCPay jede Webhook-Zustellung signiert. Ohne diesen Wert
# startet die API nicht (src/server.ts).
#
# Warum kein Standardwert: wer das Geheimnis kennt, kann eine Zustellung mit
# gueltiger Signatur erzeugen - und der Webhook verleiht daraufhin die Rolle
# 'subscriber' (ADR-003: das Abonnement ist das Stimmrecht). Ein fest
# eingebautes Geheimnis waere also eine Hintertuer zum Stimmrecht.
#
# Das Verfahren: BTCPay schickt den Kopf 'BTCPay-Sig' mit
# hex(hmac_sha256(geheimnis, ROHER_KOERPER)). Geprueft wird ueber die rohen Bytes
# der Anfrage - nicht ueber eine neu serialisierte Fassung (siehe api/README.md,
# "BTCPay-Webhook").
#
# Der Wert kommt aus BTCPay Server: Store -> Webhooks -> <Webhook> -> Secret.
BTCPAY_WEBHOOK_SECRET=BITTE_DAS_WEBHOOK_GEHEIMNIS_AUS_BTCPAY_EINSETZEN

# -----------------------------------------------------------------------------
# PORT - optional
# -----------------------------------------------------------------------------
# Port der HTTP-Schnittstelle. Standard: 3000. Erlaubt: 1..65535.
# Ein unbrauchbarer Wert (Text, 0, 70000) fuehrt zum Abbruch beim Start.
PORT=3000

# -----------------------------------------------------------------------------
# HOST - optional
# -----------------------------------------------------------------------------
# Adresse, auf der gelauscht wird. Standard: 127.0.0.1 - also nur lokal
# erreichbar. In einem Container (Docker Compose, Roadmap Phase 3.1) auf
# 0.0.0.0 setzen, sonst ist die API von aussen nicht ansprechbar.
HOST=127.0.0.1

# -----------------------------------------------------------------------------
# NODE_ENV - optional
# -----------------------------------------------------------------------------
# Erlaubt: development, test, production. Standard: development.
NODE_ENV=development