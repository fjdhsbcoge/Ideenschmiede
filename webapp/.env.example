# Umgebungsvariablen der Webapp (Vite).
#
# Kopie als .env.local anlegen (diese Datei ist die Vorlage und wird
# mitgeliefert). Vite liest .env und .env.local; Variablen MUESSEN mit VITE_
# beginnen, sonst landen sie nicht im Browser-Bundle.
#
# Leere Werte bedeuten "nicht gesetzt". Beide Variablen koennen deshalb
# unveraendert leer bleiben - das ist der Standard und der sichere Zustand.

# Wo die API liegt.
#
# FEHLT DIESE VARIABLE, ZEIGT DIE SEITE DIE BEISPIELDATEN AUS DEM REPOSITORY.
# Das ist der Standard: die oeffentliche Seite (GitHub Pages,
# https://ideenschmiede-forum.de/) wird ohne laufende API ausgeliefert und
# funktioniert unveraendert weiter.
#
# Gesetzt wird die API versucht. Antwortet sie nicht, bleiben die Beispieldaten
# stehen - und ueber der Seite erscheint ein Hinweis mit dem Grund.
#
# Beispiele:
#   /api                        gleicher Ursprung (Entwicklung hinter dem
#                               Vite-Proxy, Betrieb hinter dem Reverse Proxy)
#   http://127.0.0.1:3000/api   die lokal laufende API
VITE_API_BASE_URL=

# Ausdruecklicher Schalter - nur noetig, wenn die Entscheidung NICHT aus
# VITE_API_BASE_URL folgen soll.
#
#   api      Die API wird versucht, auch ohne VITE_API_BASE_URL (dann '/api').
#   sample   Es bleiben IMMER die Beispieldaten, auch wenn
#            VITE_API_BASE_URL gesetzt ist. Das ist der Notaus: damit laesst
#            sich die oeffentliche Seite sofort wieder auf den sicheren Stand
#            stellen, ohne die Basis-URL anzufassen.
#
# Fehlt die Variable (oder steht etwas anderes darin), entscheidet allein
# VITE_API_BASE_URL. Der Schalter ist NICHT noetig, um die API einzuschalten.
VITE_IDEAS_SOURCE=
